generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================================
// MODELOS PRINCIPALES
// ===========================================

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  passwordHash    String
  name            String
  avatarUrl       String?
  anniversaryDate DateTime?
  twoFaSecret     String?
  twoFaEnabled    Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relaciones
  sessions        Session[]
  notes           Note[]
  noteReplies     NoteReply[]
  noteReactions   NoteReaction[]
  photos          Photo[]
  albums          Album[]
  events          Event[]
  eventResponses  EventResponse[]
  wishes          Wish[]
  wishVotes       WishVote[]
  wishComments    WishComment[]
  milestones      Milestone[]
  notifications   Notification[]
  settings        Setting[]
  activityLogs    ActivityLog[]

  @@map("users")
}

model Session {
  id         String   @id @default(uuid())
  userId     String
  token      String   @unique
  refreshToken String?
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// ===========================================
// SISTEMA DE NOTAS
// ===========================================

model Note {
  id            String   @id @default(uuid())
  userId        String
  title         String
  content       String
  category      String   @default("general")
  isFavorite    Boolean  @default(false)
  isArchived    Boolean  @default(false)
  scheduledDate DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies    NoteReply[]
  reactions  NoteReaction[]
  attachments NoteAttachment[]

  @@map("notes")
}

model NoteReply {
  id        String   @id @default(uuid())
  noteId    String
  userId    String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("note_replies")
}

model NoteReaction {
  id            String   @id @default(uuid())
  noteId        String
  userId        String
  reactionType  String   // heart, star, smile, etc.
  createdAt     DateTime @default(now())

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([noteId, userId, reactionType])
  @@map("note_reactions")
}

model NoteAttachment {
  id        String   @id @default(uuid())
  noteId    String
  filePath  String
  fileType  String
  fileSize  Int
  createdAt DateTime @default(now())

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@map("note_attachments")
}

// ===========================================
// GALERÍA DE FOTOS
// ===========================================

model Photo {
  id            String    @id @default(uuid())
  userId        String
  albumId       String?
  originalPath  String
  compressedPath String?
  thumbnailPath String?
  caption       String?
  description   String?
  isFavorite    Boolean   @default(false)
  gpsLat        Float?
  gpsLon        Float?
  takenAt       DateTime?
  fileSize      Int?
  mimeType      String?
  width         Int?
  height        Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  album Album?     @relation(fields: [albumId], references: [id], onDelete: SetNull)
  tags  PhotoTag[]

  @@map("photos")
}

model Album {
  id          String   @id @default(uuid())
  userId      String
  name        String
  description String?
  coverPhotoId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  photos Photo[]

  @@map("albums")
}

model PhotoTag {
  id        String   @id @default(uuid())
  photoId   String
  tagName   String
  createdAt DateTime @default(now())

  photo Photo @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@map("photo_tags")
}

// ===========================================
// CALENDARIO DE EVENTOS
// ===========================================

model Event {
  id              String    @id @default(uuid())
  userId          String
  title           String
  description     String?
  date            DateTime
  time            String?
  location        String?
  category        String    @default("general")
  reminderMinutes Int       @default(60)
  isRecurring     Boolean   @default(false)
  recurrenceRule  String?   // RRULE format
  createdBy       String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  responses EventResponse[]

  @@map("events")
}

model EventResponse {
  id             String   @id @default(uuid())
  eventId        String
  userId         String
  responseStatus String   // accepted, rejected, pending
  createdAt      DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@map("event_responses")
}

// ===========================================
// LISTA DE DESEOS
// ===========================================

model Wish {
  id          String   @id @default(uuid())
  userId      String
  title       String
  description String?
  category    String   @default("general")
  priority    Int      @default(1)
  isCompleted Boolean  @default(false)
  budget      Float?
  deadline    DateTime?
  link        String?
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  votes    WishVote[]
  comments WishComment[]

  @@map("wishes")
}

model WishVote {
  id        String   @id @default(uuid())
  wishId    String
  userId    String
  voteValue Int      // 1 upvote, -1 downvote
  createdAt DateTime @default(now())

  wish Wish @relation(fields: [wishId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([wishId, userId])
  @@map("wish_votes")
}

model WishComment {
  id        String   @id @default(uuid())
  wishId    String
  userId    String
  content   String
  createdAt DateTime @default(now())

  wish Wish @relation(fields: [wishId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wish_comments")
}

// ===========================================
// HITOS / MILESTONES
// ===========================================

model Milestone {
  id          String   @id @default(uuid())
  userId      String
  title       String
  description String?
  date        DateTime
  photoId     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("milestones")
}

// ===========================================
// NOTIFICACIONES
// ===========================================

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  message   String
  data      String?  // JSON string
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

// ===========================================
// BACKUPS
// ===========================================

model Backup {
  id        String   @id @default(uuid())
  filePath  String
  fileSize  Int
  type      String   // full, database, files
  status    String   // pending, completed, failed
  metadata  String?  // JSON string
  createdAt DateTime @default(now())

  @@map("backups")
}

// ===========================================
// LOGS DE ACTIVIDAD
// ===========================================

model ActivityLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entityType String?
  entityId   String?
  metadata   String?  // JSON string
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("activity_logs")
}

// ===========================================
// CONFIGURACIÓN
// ===========================================

model Setting {
  id        String   @id @default(uuid())
  userId    String
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@map("settings")
}
