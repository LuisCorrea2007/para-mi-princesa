# ===========================================
# NUESTRO ESPACIO - Variables de Entorno
# ===========================================

# -------------------------------------------
# BACKEND
# -------------------------------------------

# Entorno (development, production)
NODE_ENV=development

# Puerto del servidor backend
PORT=5000

# URL de conexión a la base de datos
# PostgreSQL:
DATABASE_URL="postgresql://nuestro_espacio:password123@localhost:5432/nuestro_espacio?schema=public"
# SQLite (alternativa):
# DATABASE_URL="file:./dev.db"

# Secretos para JWT
JWT_SECRET=tu_secreto_jwt_muy_seguro_cambialo_en_produccion
JWT_REFRESH_SECRET=tu_secreto_refresh_token_cambialo_en_produccion
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Configuración de subida de archivos
UPLOAD_MAX_SIZE=10485760
UPLOAD_PATH=./uploads
BACKUP_PATH=./backups

# Clave de encriptación para datos sensibles (32 caracteres)
ENCRYPTION_KEY=cambia_esta_clave_por_una_de_32_caracteres

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS (orígenes permitidos)
CORS_ORIGIN=http://localhost:5173

# SMTP (opcional, para recuperación de contraseña)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Nuestro Espacio <noreply@nuestro-espacio.local>"

# 2FA (TOTP)
TWO_FA_ISSUER=NuestroEspacio
TWO_FA_PERIOD=30
TWO_FA_DIGITS=6

# Limpieza automática
CLEANUP_TEMP_HOURS=24
CLEANUP_BACKUP_DAYS=30

# -------------------------------------------
# FRONTEND
# -------------------------------------------

# URL de la API backend
VITE_API_URL=http://localhost:5000/api

# URL para WebSockets
VITE_WS_URL=http://localhost:5000

# Modo de producción
VITE_NODE_ENV=development

# Título de la aplicación
VITE_APP_TITLE=Nuestro Espacio

# -------------------------------------------
# DOCKER
# -------------------------------------------

# Puertos expuestos
DOCKER_BACKEND_PORT=5000
DOCKER_FRONTEND_PORT=3000
DOCKER_DB_PORT=5432

# Volúmenes
DOCKER_DATA_PATH=./data
DOCKER_BACKUP_PATH=./backups

# -------------------------------------------
# BASE DE DATOS (Docker)
# -------------------------------------------

POSTGRES_USER=nuestro_espacio
POSTGRES_PASSWORD=password123
POSTGRES_DB=nuestro_espacio
